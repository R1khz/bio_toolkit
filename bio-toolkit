#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_PYTHON="$ROOT_DIR/.venv/bin/python"

if [[ ! -x "$VENV_PYTHON" ]]; then
  echo "Virtual environment not found at $VENV_PYTHON" >&2
  echo "Run: python3 -m venv .venv && ./.venv/bin/python -m ensurepip --upgrade" >&2
  echo "Then install dependencies with: ./.venv/bin/pip install -e \".[dev]\"" >&2
  exit 1
fi

if ! "$VENV_PYTHON" -c '
import sys
from pathlib import Path

expected_root = Path(sys.argv[1]).resolve() / "src" / "bio_toolkit"
try:
    import bio_toolkit
except ModuleNotFoundError:
    raise SystemExit(1)

package_root = Path(bio_toolkit.__file__).resolve().parent
raise SystemExit(0 if package_root == expected_root else 1)
' "$ROOT_DIR"; then
  echo "Bio Toolkit is not installed for this clone, or the editable install is stale." >&2
  echo "Run: ./.venv/bin/python -m pip install -e \".[dev]\"" >&2
  exit 1
fi

exec "$VENV_PYTHON" -m bio_toolkit "$@"
