#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_PYTHON="$ROOT_DIR/.venv/bin/python"

if [[ ! -x "$VENV_PYTHON" ]]; then
  echo "Virtual environment not found at $VENV_PYTHON" >&2
  echo "Run: python3 -m venv .venv && ./.venv/bin/python -m ensurepip --upgrade" >&2
  echo "Then install dependencies with: ./.venv/bin/pip install -e \".[dev]\"" >&2
  exit 1
fi

export PYTHONPATH="$ROOT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$VENV_PYTHON" -m bio_toolkit "$@"
